<?xml version="1.0" encoding="utf-8"?><Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="clr-namespace:Classin视频解析下载工具.ViewModels" x:Class="Classin视频解析下载工具.Views.SplashView" x:DataType="vm:SplashViewModel" Title="Classin视频解析下载工具" Height="280" Width="500" Background="#FF2B2B2B" WindowStartupLocation="CenterScreen" CanResize="False" ShowInTaskbar="False"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Border Grid.Row="0" Margin="0,40,0,20" HorizontalAlignment="Center"><TextBlock Text="ClassIn" FontSize="42" FontWeight="Bold" Foreground="#FF4FC3F7" HorizontalAlignment="Center"/></Border><TextBlock Grid.Row="1" Text="视频解析下载工具" FontSize="18" Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,10"/><ProgressBar Grid.Row="2" Width="300" Height="6" Background="#FF3A3A3A" Maximum="100" Value="{Binding ProgressValue}" Margin="0,0,0,15"><ProgressBar.Styles><Style Selector="ProgressBar"><Setter Property="Foreground" Value="#FF4FC3F7"/><Setter Property="CornerRadius" Value="3"/></Style></ProgressBar.Styles></ProgressBar><TextBlock Grid.Row="3" Text="{Binding StatusText}" FontSize="12" Foreground="#FF888888" HorizontalAlignment="Center" Margin="0,10,0,0"/></Grid></Window>
