# 统一编辑器配置（参考 AI-IDE 标准）
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yml,yaml,json}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.{rs}]
indent_size = 4

[*.{cs}]
indent_size = 4

[*.{ts,tsx,js,jsx,html,css}]
indent_size = 2
